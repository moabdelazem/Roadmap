# Fine-grained GitHub token limited to this repository, with
# "Contents: Read and write" permission. Needed to clone (private repo)
# and to push progress.
GITHUB_TOKEN=

# Who progress commits are authored as.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=

# Optional
# REPO_URL=https://github.com/moabdelazem/Roadmap.git
# BRANCH=main
# COMMIT_DELAY=20    # quiet seconds before ticks are committed and pushed
# PULL_INTERVAL=60   # how often to pull plan changes from GitHub
